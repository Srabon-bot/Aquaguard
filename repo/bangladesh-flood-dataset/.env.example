# Only needed if you're re-running train/ingest_mcdwd.py (NASA MODIS/VIIRS
# Global Flood Product). Register a free account at
# https://urs.earthdata.nasa.gov/, then generate a token from your profile's
# "Generate Token" tab (or use your username/password instead).
#
# Copy this file to .env and fill in real values -- .env itself is gitignored.

EARTHDATA_TOKEN=

# Alternative to the token above:
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=

# Only needed if you're re-running train/ingest_global_flood_db.py (Google
# Earth Engine). Your own Google Cloud project ID with the Earth Engine API
# enabled -- see https://console.cloud.google.com/, then run
# `earthengine authenticate` once before use.
EE_PROJECT=

# Comma-separated list of frontend origins allowed to call this API.
# Example for local dev: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=*

# Open-Meteo has no API key requirement for the free tier; left here in case
# you switch to a paid/other provider later.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Path to the trained model file, relative to backend/
MODEL_PATH=app/models/artifacts/risk_model.joblib
